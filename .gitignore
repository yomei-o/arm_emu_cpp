# Guest trees. These are downloads, not sources -- resume.md says where each one
# comes from and the commands to fetch it. Committing a 120 MB toolchain would make
# the repository unusable for the sake of saving one curl.
guests/*
!guests/README.md
!guests/fixup.sh
!guests/fetch_rpi.sh
!guests/deb_unpack.py
!guests/rpi-packages.txt
